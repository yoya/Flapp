// StyleSheet を TextField に当てたときの書式、text / htmlText の変化。実機の値を測る
var t:Function = function(name:String, f:Function):void { try { trace(name, f()); } catch (e:Error) { trace(name, "ERR", e.errorID); } };
var tf:TextField = new TextField(); addChild(tf); tf.width = 300; tf.height = 100; tf.multiline = true; tf.wordWrap = true;
var ss:StyleSheet = new StyleSheet();
ss.parseCSS("p { color: #ff0000; font-size: 20px; font-family: Arial; font-weight: bold; text-align: center; margin-left: 10px; margin-right: 6px; text-indent: 5px; letter-spacing: 2px; leading: 3px; } .big { font-size: 30px; color: #00ff00; } a:link { color: #0000ff; } a:hover { text-decoration: underline; } em { font-style: italic; } li { color: #888888; } b { color: #123456; } body { font-size: 16px; }");
var fmt:Function = function(a:int, b:int):String { var f:TextFormat = tf.getTextFormat(a, b); return [f.font, f.size, f.color, f.bold, f.italic, f.underline, f.url, f.target, f.align, f.leftMargin, f.rightMargin, f.indent, f.leading, f.blockIndent, f.bullet, f.letterSpacing, f.kerning, f.display].join("/"); };
var show:Function = function(s:String):String { return s.split("\r").join("\\r").split("\n").join("\\n"); };
t("get styleSheet", function():* { return tf.styleSheet; });
t("names", function():* { return ss.styleNames.sort().join(","); });
t("getStyle p", function():* { var s:Object = ss.getStyle("p"); var o:Array = []; for (var k:String in s) o.push(k + "=" + s[k]); return o.sort().join(";"); });
t("getStyle .big", function():* { var s:Object = ss.getStyle(".big"); var o:Array = []; for (var k:String in s) o.push(k + "=" + s[k]); return o.sort().join(";"); });
t("getStyle a:link", function():* { var s:Object = ss.getStyle("a:link"); var o:Array = []; for (var k:String in s) o.push(k + "=" + s[k]); return o.sort().join(";"); });
t("set", function():* { tf.styleSheet = ss; return tf.styleSheet === ss; });
t("p", function():* { tf.htmlText = "<p>a</p>b"; return [show(tf.text), fmt(0, 1), fmt(2, 3)].join(" | "); });
t("p out", function():* { return show(tf.htmlText); });
t("class", function():* { tf.htmlText = "<span class='big'>a</span>b"; return [show(tf.text), fmt(0, 1), fmt(1, 2)].join(" | "); });
t("class out", function():* { return show(tf.htmlText); });
t("link", function():* { tf.htmlText = "<a href='http://x.example/'>a</a>b"; return [show(tf.text), fmt(0, 1), fmt(1, 2)].join(" | "); });
t("link out", function():* { return show(tf.htmlText); });
t("em", function():* { tf.htmlText = "<em>a</em>b"; return [fmt(0, 1), fmt(1, 2)].join(" | "); });
t("b", function():* { tf.htmlText = "<b>a</b>b"; return [fmt(0, 1), fmt(1, 2)].join(" | "); });
t("li", function():* { tf.htmlText = "<li>a</li>b"; return [show(tf.text), fmt(0, 1), fmt(2, 3)].join(" | "); });
t("font tag", function():* { tf.htmlText = "<font color='#ff00ff' size='30'>a</font>b"; return [fmt(0, 1), fmt(1, 2)].join(" | "); });
t("body", function():* { tf.htmlText = "xyz"; return fmt(0, 1); });
t("text assign", function():* { tf.text = "plain <b>x</b>"; return [show(tf.text), show(tf.htmlText), fmt(0, 1)].join(" | "); });
t("text after html", function():* { tf.htmlText = "<p>a</p>"; tf.text = "q"; return [show(tf.text), show(tf.htmlText)].join(" | "); });
t("append", function():* { tf.htmlText = "<p>a</p>"; tf.appendText("z"); return [show(tf.text), show(tf.htmlText)].join(" | "); });
t("setTextFormat", function():* { tf.htmlText = "<p>ab</p>"; var f:TextFormat = new TextFormat(); f.size = 40; tf.setTextFormat(f, 0, 1); return [fmt(0, 1), fmt(1, 2)].join(" | "); });
t("defaultTextFormat", function():* { var d:TextFormat = new TextFormat(); d.size = 8; tf.defaultTextFormat = d; tf.htmlText = "k"; return fmt(0, 1); });
t("unset", function():* { tf.styleSheet = null; return [tf.styleSheet, show(tf.text), show(tf.htmlText)].join(" | "); });
t("after unset", function():* { tf.htmlText = "<p>a</p>b"; return [fmt(0, 1), fmt(2, 3)].join(" | "); });
t("selectable", function():* { tf.styleSheet = ss; return [tf.selectable, tf.type, tf.mouseEnabled].join(","); });
t("type input", function():* { tf.type = "input"; return [tf.type, tf.styleSheet === ss].join(","); });
var s2:StyleSheet = new StyleSheet();
t("set null css", function():* { tf.styleSheet = s2; tf.htmlText = "<p>a</p>"; return [show(tf.text), fmt(0, 1)].join(" | "); });
t("setStyle later", function():* { s2.setStyle("p", {color: "#abcdef", fontSize: "22px", fontWeight: "bold"}); tf.htmlText = "<p>a</p>"; return fmt(0, 1); });
t("transform", function():* { var o:Object = ss.transform({color: "#ff0000", fontSize: "20px", fontWeight: "bold", textAlign: "center", marginLeft: "10px", fontFamily: "Arial", textDecoration: "underline", fontStyle: "italic", letterSpacing: "2px", display: "block"}); return [o.font, o.size, o.color, o.bold, o.italic, o.underline, o.align, o.leftMargin, o.letterSpacing, o.display].join("/"); });
