// 型と型変換
trace("-- typeof");
trace(typeof undefined + " " + typeof null + " " + typeof true + " " + typeof 1 + " " + typeof "s");
trace(typeof {} + " " + typeof [] + " " + typeof function(){} + " " + typeof this + " " + typeof Math);
trace("-- to string");
trace(undefined);
trace(null);
trace(true);
trace("" + undefined + "," + null + "," + true + "," + false);
trace({});
trace([1,[2,3],"x"]);
trace(function(){});
trace(String(12) + String(true) + String(null));
