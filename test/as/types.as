trace("-- to number");
trace(Number("12") + " " + Number("12.5abc") + " " + Number("") + " " + Number(" 12") + " " + Number("12 "));
trace(Number("0x1F") + " " + Number("010") + " " + Number("1e3") + " " + Number(".5") + " " + Number("5."));
trace(Number(true) + " " + Number(false) + " " + Number(null) + " " + Number(undefined));
trace(Number({}) + " " + Number([5]) + " " + Number("Infinity") + " " + Number("-3"));
