// 表示オブジェクトなどのメンバー（既定値、代入と読み戻し、不正な値）を実機と比べる。ERR は errorID
var t:Function = function(name:String, f:Function):void { try { trace(name, f()); } catch (e:Error) { trace(name, "ERR", e.errorID); } };
var s:Sprite = new Sprite(); var s2:Sprite = new Sprite(); var m:MovieClip = new MovieClip(); var tf:TextField = new TextField();
addChild(s); addChild(s2); addChild(m); addChild(tf);
t("mask default", function():* { return s.mask; });
t("mask set", function():* { s.mask = s2; return [s.mask == s2, s2.mask].join(","); });
t("mask null", function():* { s.mask = null; return s.mask; });
t("blendMode default", function():* { return s.blendMode; });
t("blendMode set", function():* { s.blendMode = BlendMode.MULTIPLY; return s.blendMode; });
t("blendMode bogus", function():* { s.blendMode = "bogus"; return s.blendMode; });
t("blendMode null", function():* { s.blendMode = null; return s.blendMode; });
t("blendMode upper", function():* { s.blendMode = "ADD"; return s.blendMode; });
t("cacheAsBitmap", function():* { var a:Boolean = s.cacheAsBitmap; s.cacheAsBitmap = true; return [a, s.cacheAsBitmap].join(","); });
t("scrollRect default", function():* { return s.scrollRect; });
t("scrollRect set", function():* { var r:Rectangle = new Rectangle(1, 2, 30, 40); s.scrollRect = r; var g:Rectangle = s.scrollRect; r.x = 99; return [g, s.scrollRect, g == s.scrollRect].join(" "); });
t("scrollRect null", function():* { s.scrollRect = null; return s.scrollRect; });
t("scale9Grid", function():* { var a:* = s.scale9Grid; s.scale9Grid = new Rectangle(5, 5, 10, 10); return [a, s.scale9Grid].join(" "); });
t("accessibilityProperties", function():* { var a:* = s.accessibilityProperties; s.accessibilityProperties = new AccessibilityProperties(); return [a, s.accessibilityProperties != null].join(","); });
t("3D defaults", function():* { return [s.z, s.rotationX, s.rotationY, s.rotationZ, s.scaleZ].join(","); });
t("3D set", function():* { s.z = 10; s.rotationX = 30; return [s.z, s.rotationX, s.rotationY, s.rotationZ, s.scaleZ].join(","); });
t("tabIndex", function():* { var a:int = s.tabIndex; s.tabIndex = 5; var b:int = s.tabIndex; s.tabIndex = -3; return [a, b, s.tabIndex].join(","); });
t("tabEnabled", function():* { var a:Boolean = s.tabEnabled; var b:Boolean = m.tabEnabled; s.tabEnabled = true; return [a, b, s.tabEnabled, tf.tabEnabled].join(","); });
t("tabChildren", function():* { var a:Boolean = s.tabChildren; s.tabChildren = false; return [a, s.tabChildren].join(","); });
t("mouseChildren", function():* { var a:Boolean = s.mouseChildren; s.mouseChildren = false; return [a, s.mouseChildren].join(","); });
t("mouseEnabled", function():* { var a:Boolean = s.mouseEnabled; s.mouseEnabled = false; return [a, s.mouseEnabled, tf.mouseEnabled].join(","); });
t("focusRect", function():* { var a:* = s.focusRect; s.focusRect = false; var b:* = s.focusRect; s.focusRect = null; return [a, b, s.focusRect].join(","); });
t("contextMenu", function():* { var a:* = s.contextMenu; var cm:ContextMenu = new ContextMenu(); s.contextMenu = cm; return [a, s.contextMenu == cm].join(","); });
t("hitArea", function():* { var a:* = s.hitArea; s.hitArea = s2; var b:Boolean = s.hitArea == s2; s.hitArea = null; return [a, b, s.hitArea].join(","); });
t("dropTarget", function():* { return s.dropTarget; });
t("buttonMode", function():* { var a:Boolean = s.buttonMode; s.buttonMode = true; return [a, s.buttonMode, s.useHandCursor].join(","); });
t("startDrag", function():* { s.startDrag(); s.stopDrag(); s.startDrag(true, new Rectangle(0, 0, 10, 10)); s.stopDrag(); return "ok"; });
t("MovieClip.enabled", function():* { var a:Boolean = m.enabled; m.enabled = false; return [a, m.enabled].join(","); });
t("MovieClip misc", function():* { return [m.trackAsMenu, m.totalFrames, m.currentFrame, m.framesLoaded, m.currentLabel, m.currentLabels.length, m.currentScene.name, m.scenes.length].join(","); });
t("getObjectsUnderPoint", function():* { return [stage.getObjectsUnderPoint(new Point(0, 0)).length, s.getObjectsUnderPoint(new Point(0, 0)).length, stage.areInaccessibleObjectsUnderPoint(new Point(0, 0))].join(","); });
t("stage.quality", function():* { var a:String = stage.quality; stage.quality = StageQuality.LOW; var b:String = stage.quality; stage.quality = "bogus"; return [a, b, stage.quality].join(","); });
t("stage.displayState", function():* { return [stage.displayState, stage.fullScreenWidth > 0, stage.fullScreenHeight > 0, stage.fullScreenSourceRect, stage.stageFocusRect, stage.allowsFullScreen, stage.wmodeGPU].join(","); });
t("stage.scaleMode", function():* { return [stage.scaleMode, stage.align, stage.stageWidth, stage.stageHeight, stage.showDefaultContextMenu, stage.tabChildren, stage.mouseChildren, stage.color].join(","); });
t("stage.invalidate", function():* { stage.invalidate(); return "ok"; });
t("stage.set", function():* { stage.scaleMode = "bogus"; var a:String = stage.scaleMode; stage.align = "bogus"; var b:String = stage.align; stage.scaleMode = StageScaleMode.NO_SCALE; stage.align = StageAlign.TOP_LEFT; return [a, b, stage.scaleMode, stage.align].join(","); });
t("stage.focus", function():* { stage.focus = s; return [stage.focus == s, stage.focus == null].join(","); });
t("stage.frameRate", function():* { var a:Number = stage.frameRate; stage.frameRate = 30; return [a, stage.frameRate].join(","); });
t("getLineMetrics", function():* { tf.text = "Hello"; var lm:TextLineMetrics = tf.getLineMetrics(0); return [lm is TextLineMetrics, lm.width > 0, lm.height > 0, lm.ascent > 0].join(","); });
t("tf props", function():* { return [tf.numLines, tf.length, tf.maxChars, tf.restrict, tf.displayAsPassword, tf.selectable, tf.type, tf.multiline, tf.wordWrap, tf.autoSize, tf.border, tf.background, tf.condenseWhite, tf.mouseWheelEnabled, tf.antiAliasType, tf.gridFitType, tf.sharpness, tf.thickness, tf.useRichTextClipboard, tf.styleSheet].join(","); });
t("tf sel", function():* { tf.setSelection(1, 3); return [tf.selectionBeginIndex, tf.selectionEndIndex, tf.caretIndex, tf.selectedText].join(","); });
t("tf more", function():* { return [tf.bottomScrollV, tf.maxScrollH, tf.maxScrollV, tf.scrollH, tf.scrollV, tf.textHeight > 0, tf.textWidth > 0].join(","); });
t("tf methods", function():* { return [tf.getCharIndexAtPoint(1, 1), tf.getLineIndexAtPoint(1, 1), tf.getLineLength(0), tf.getLineText(0), tf.getLineOffset(0), tf.getParagraphLength(0), tf.getFirstCharInParagraph(0), tf.getCharBoundaries(0) is Rectangle, tf.getImageReference("x")].join(","); });
t("tf replace", function():* { tf.text = "Hello world"; tf.replaceText(0, 5, "Bye"); tf.appendText("!"); tf.replaceSelectedText("X"); return tf.text; });
t("tf format", function():* { var f:TextFormat = new TextFormat("Arial", 20, 0xff0000, true, true, true, "u", "t", "center", 5, 6, 7, 8); tf.defaultTextFormat = f; tf.text = "ab"; var g:TextFormat = tf.getTextFormat(0, 1); return [g.font, g.size, g.color, g.bold, g.italic, g.underline, g.url, g.target, g.align, g.leftMargin, g.rightMargin, g.indent, g.leading].join(","); });
t("tf html", function():* { tf.htmlText = "<b>x</b><i>y</i>"; return [tf.text, tf.htmlText.length > 0, tf.getTextFormat(0, 1).bold, tf.getTextFormat(1, 2).italic].join(","); });
t("tf type", function():* { tf.type = TextFieldType.INPUT; tf.text = "abc"; var a:String = tf.type; tf.type = "bogus"; return [a, tf.type].join(","); });
trace("done");
