// flash.geom（Point・Rectangle・Matrix・ColorTransform・Transform）と flash.display.BitmapData（AS2）。実機の値を測る
// size: 200x150
// sprite: 1 frames 1 export pic square 20
stop();
var P = flash.geom.Point;
var R = flash.geom.Rectangle;
var M = flash.geom.Matrix;
var CT = flash.geom.ColorTransform;
var BD = flash.display.BitmapData;
var keys = function(o) { var a = []; for (var k in o) a.push(k); a.sort(); return a.join(","); };
var p = new P(3, 4);
trace("point " + p + " " + p.length + " " + keys(p));
trace("point ops " + p.add(new P(1, 1)) + " " + p.subtract(new P(1, 1)) + " " + p.clone() + " " + p.equals(new P(3, 4)) + " " + P.distance(p, new P(0, 0)) + " " + P.interpolate(new P(0, 0), new P(10, 10), 0.25) + " " + P.polar(2, 0));
p.normalize(10); trace("normalize " + p); p.offset(1, 2); trace("offset " + p);
trace("point empty " + new P() + " " + new P("a", null));
var r = new R(1, 2, 10, 20);
trace("rect " + r + " " + keys(r));
trace("rect props " + [r.left, r.right, r.top, r.bottom, r.topLeft, r.bottomRight, r.size].join(" "));
trace("rect ops " + [r.contains(5, 5), r.containsPoint(new P(0, 0)), r.containsRectangle(new R(2, 3, 1, 1)), r.intersects(new R(5, 5, 100, 100)), r.intersection(new R(5, 5, 100, 100)), r.union(new R(0, 0, 1, 1)), r.isEmpty(), r.clone(), r.equals(new R(1, 2, 10, 20))].join(" "));
r.inflate(1, 2); trace("inflate " + r); r.offset(5, 5); trace("roffset " + r); r.setEmpty(); trace("setEmpty " + r + " " + r.isEmpty());
trace("rect empty " + new R());
var m = new M();
trace("matrix " + m + " " + keys(m));
m.translate(10, 20); m.scale(2, 3); trace("ms " + m);
m.rotate(Math.PI / 2); trace("mr " + m);
var m2 = new M(1, 2, 3, 4, 5, 6); m2.invert(); trace("inv " + m2);
trace("tp " + new M(2, 0, 0, 2, 10, 10).transformPoint(new P(1, 1)) + " " + new M(2, 0, 0, 2, 10, 10).deltaTransformPoint(new P(1, 1)));
var m3 = new M(); m3.createBox(2, 3, 0, 5, 6); trace("box " + m3); m3.createGradientBox(100, 50, 0, 10, 20); trace("gbox " + m3);
var m4 = new M(1, 0, 0, 1, 5, 0); m4.concat(new M(2, 0, 0, 2, 0, 0)); trace("concat " + m4); m4.identity(); trace("identity " + m4);
var ct = new CT(); trace("ct " + ct + " " + keys(ct));
ct.rgb = 0xff8000; trace("ct rgb " + ct + " " + ct.rgb);
var ct2 = new CT(0.5, 1, 1, 1, 10, 0, 0, 0); ct2.concat(new CT(2, 1, 1, 1, 0, 5, 0, 0)); trace("ct concat " + ct2);
this.createEmptyMovieClip("mc", 1); mc._x = 10; mc._y = 20; mc._xscale = 200;
mc.beginFill(0xff0000); mc.moveTo(0, 0); mc.lineTo(10, 0); mc.lineTo(10, 10); mc.lineTo(0, 10); mc.endFill();
var tr = mc.transform;
trace("transform " + (tr instanceof flash.geom.Transform) + " " + tr.matrix + " " + tr.colorTransform + " " + tr.concatenatedMatrix + " " + tr.pixelBounds);
var nm = new M(1, 0, 0, 1, 50, 60); tr.matrix = nm; trace("tr set " + mc._x + " " + mc._y + " " + mc._xscale);
var nct = new CT(1, 1, 1, 0.5, 0, 0, 0, 0); tr.colorTransform = nct; trace("ct set " + mc._alpha);
var bd = new BD(10, 8, true, 0x80ff0000);
trace("bd " + [bd.width, bd.height, bd.transparent, bd.rect, bd.getPixel32(0, 0).toString(16), bd.getPixel(0, 0).toString(16), keys(bd)].join(" "));
bd.setPixel32(1, 1, 0xff00ff00); bd.setPixel(2, 2, 0x0000ff); trace("set " + bd.getPixel32(1, 1).toString(16) + " " + bd.getPixel32(2, 2).toString(16) + " " + bd.getPixel32(-1, 0));
bd.fillRect(new R(5, 5, 3, 3), 0xff123456); trace("fill " + bd.getPixel32(6, 6).toString(16));
var bd2 = bd.clone(); trace("clone " + bd2.getPixel32(6, 6).toString(16) + " " + (bd2 == bd));
var op = new BD(4, 4, false, 0xffffffff); op.copyPixels(bd, new R(0, 0, 4, 4), new P(0, 0)); trace("copy " + op.getPixel32(1, 1).toString(16) + " " + op.getPixel32(0, 0).toString(16));
trace("defaults " + new BD(2, 2).getPixel32(0, 0).toString(16) + " " + new BD(2, 2).transparent);
trace("bad size " + new BD(0, 5) + " " + new BD(3000, 3000) + " " + new BD(2880, 1).width);
bd.dispose(); trace("disposed " + bd.width + " " + bd.getPixel(0, 0));
var lb = BD.loadBitmap("pic"); trace("loadBitmap " + lb);
var small = new BD(20, 20, false, 0xff0000ff);
this.createEmptyMovieClip("holder", 2); holder._x = 120; holder._y = 10;
holder.attachBitmap(small, 1);
trace("attach " + holder._width + " " + holder._height);
this.createEmptyMovieClip("filler", 3); filler._x = 150; filler._y = 60;
var fm = new M(); fm.scale(2, 2);
var checker = new BD(2, 2, false, 0xffff0000); checker.setPixel(1, 0, 0x00ff00); checker.setPixel(0, 1, 0x00ff00);
filler.beginBitmapFill(checker, fm, true, false); filler.moveTo(0, 0); filler.lineTo(40, 0); filler.lineTo(40, 40); filler.lineTo(0, 40); filler.endFill();
trace("filler " + filler._width);
var drawn = new BD(30, 30, true, 0);
trace("hit " + small.hitTest(new P(0, 0), 255, new P(5, 5)));
small.floodFill(0, 0, 0xffffff00); trace("flood " + small.getPixel(10, 10).toString(16));
trace("bounds " + small.getColorBoundsRect(0xffffffff, 0xffffff00, true));
