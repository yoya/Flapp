// TextField.StyleSheet（AS2）。実機の値を測る
// frames: 1
stop();
var show = function(o) { if (o == undefined) return String(o); var a = []; for (var k in o) a.push(k + "=" + o[k]); a.sort(); return a.join(";"); };
var ss = new TextField.StyleSheet();
trace("typeof " + typeof TextField.StyleSheet + " " + typeof ss + " " + (ss instanceof TextField.StyleSheet));
trace("parse ok " + ss.parseCSS("p { color: #ff0000; font-size: 20px; font-weight: bold; } .big { font-size: 30px; } a:link { color: #0000ff; } span { color: #00ff00; } em { font-style: italic; }"));
trace("names " + ss.getStyleNames().sort().join(","));
trace("getStyle p " + show(ss.getStyle("p")));
trace("getStyle P " + show(ss.getStyle("P")));
trace("getStyle none " + show(ss.getStyle("zz")));
trace("parse bad " + ss.parseCSS("q { color #ff0000 }"));
trace("names after bad " + ss.getStyleNames().sort().join(","));
ss.setStyle("Q", {color: "#111111"});
trace("setStyle " + ss.getStyleNames().sort().join(",") + " " + show(ss.getStyle("q")));
var t = ss.transform({color: "#ff0000", fontSize: "20px", fontWeight: "bold", textAlign: "center", marginLeft: "5px", fontFamily: "sans-serif"});
trace("transform " + (t instanceof TextFormat) + " " + [t.color, t.size, t.bold, t.align, t.leftMargin, t.font].join(","));
this.createTextField("tf", 1, 10, 10, 300, 100);
tf.multiline = true; tf.wordWrap = true; tf.html = true;
trace("styleSheet default " + tf.styleSheet);
tf.styleSheet = ss;
trace("styleSheet set " + (tf.styleSheet == ss));
tf.htmlText = "<p>a</p><span class='big'>b</span><a href='x'>c</a>";
var f = function(a, b) { var x = tf.getTextFormat(a, b); return [x.font, x.size, x.color, x.bold, x.italic, x.url].join("/"); };
trace("text [" + tf.text.split("\r").join("\\r") + "]");
trace("fmt p " + f(0, 1) + " | span " + f(2, 3) + " | a " + f(3, 4));
trace("htmlText " + tf.htmlText);
tf.text = "<p>q</p>";
trace("text assign [" + tf.text.split("\r").join("\\r") + "] " + tf.htmlText);
tf.htmlText = "<em>e</em>z";
trace("em [" + tf.text.split("\r").join("\\r") + "] " + f(0, 1));
var tfmt = new TextFormat(); tfmt.size = 40;
tf.setTextFormat(tfmt); trace("setTextFormat " + f(0, 1));
ss.setStyle("p", {color: "#999999"});
tf.htmlText = "<p>r</p>"; trace("after setStyle " + f(0, 1));
ss.clear(); trace("clear " + ss.getStyleNames().length + " " + f(0, 1));
tf.styleSheet = undefined;
trace("unset " + tf.styleSheet + " " + tf.htmlText);
trace("load " + typeof ss.load + " " + typeof ss.onLoad);
