// flash.xml の XMLDocument / XMLNode（AS3 の旧 XML）。実機の値を測る
var t:Function = function(name:String, f:Function):void { try { trace(name, f()); } catch (err:Error) { trace(name, "ERR", err.errorID); } };
var attrs:Function = function(n:XMLNode):String { var o:Array = []; for (var k:String in n.attributes) o.push(k + "=" + n.attributes[k]); return o.join(","); };
t("parse", function():* { var d:XMLDocument = new XMLDocument("<a x='1' y=\"2\"><b>t&amp;x</b><c/>tail</a>"); return [d.firstChild.nodeName, attrs(d.firstChild), d.firstChild.childNodes.length, d.firstChild.firstChild.firstChild.nodeValue, d.toString()].join(" | "); });
t("types", function():* { var d:XMLDocument = new XMLDocument("<a>t</a>"); return [d.nodeType, d.nodeName, d.firstChild.nodeType, d.firstChild.firstChild.nodeType, d.firstChild.firstChild.nodeName, XMLNodeType.ELEMENT_NODE, XMLNodeType.TEXT_NODE].join(","); });
t("ignoreWhite", function():* { var d:XMLDocument = new XMLDocument(); d.ignoreWhite = true; d.parseXML("<a>\n  <b/>\n  <c> x </c>\n</a>"); return [d.firstChild.childNodes.length, d.toString()].join(" | "); });
t("ws kept", function():* { var d:XMLDocument = new XMLDocument("<a>\n <b/></a>"); return d.firstChild.childNodes.length; });
t("decl", function():* { var d:XMLDocument = new XMLDocument("<?xml version='1.0'?><!DOCTYPE a><a/>"); return [d.xmlDecl, d.docTypeDecl, d.toString()].join(" | "); });
t("unclosed", function():* { var d:XMLDocument = new XMLDocument("<a><b></a>"); return d.toString(); });
t("unopened", function():* { var d:XMLDocument = new XMLDocument("<a></b>"); return d.toString(); });
t("bad attr", function():* { var d:XMLDocument = new XMLDocument("<a x=1/>"); return d.toString(); });
t("cdata", function():* { var d:XMLDocument = new XMLDocument("<a><![CDATA[<x>]]></a>"); return [d.firstChild.firstChild.nodeValue, d.toString()].join(" | "); });
t("comment", function():* { var d:XMLDocument = new XMLDocument("<a><!-- c --><b/></a>"); return [d.firstChild.childNodes.length, d.toString()].join(" | "); });
t("entities", function():* { var d:XMLDocument = new XMLDocument("<a q='&lt;&quot;'>&#65;&#x42;&apos;&nbsp;&foo;</a>"); return [d.firstChild.attributes.q, d.firstChild.firstChild.nodeValue, d.toString()].join(" | "); });
t("create", function():* { var d:XMLDocument = new XMLDocument(); var e:XMLNode = d.createElement("item"); e.attributes.id = 5; e.attributes.name = "a<b"; e.appendChild(d.createTextNode("x & y")); d.appendChild(e); return d.toString(); });
t("attr order", function():* { var e:XMLNode = new XMLNode(1, "e"); e.attributes.z = 1; e.attributes.a = 2; e.attributes.m = 3; return e.toString(); });
t("siblings", function():* { var d:XMLDocument = new XMLDocument("<r><a/><b/><c/></r>"); var b:XMLNode = d.firstChild.childNodes[1]; return [b.previousSibling.nodeName, b.nextSibling.nodeName, b.parentNode.nodeName, d.firstChild.lastChild.nodeName, d.firstChild.firstChild.previousSibling].join(","); });
t("insertBefore", function():* { var d:XMLDocument = new XMLDocument("<r><a/><c/></r>"); var b:XMLNode = new XMLNode(1, "b"); d.firstChild.insertBefore(b, d.firstChild.lastChild); return d.toString(); });
t("removeNode", function():* { var d:XMLDocument = new XMLDocument("<r><a/><b/></r>"); d.firstChild.firstChild.removeNode(); return d.toString(); });
t("cloneNode", function():* { var d:XMLDocument = new XMLDocument("<r x='1'><a/>t</r>"); return [d.firstChild.cloneNode(false).toString(), d.firstChild.cloneNode(true).toString()].join(" | "); });
t("appendChild move", function():* { var d:XMLDocument = new XMLDocument("<r><a/><b/></r>"); d.firstChild.appendChild(d.firstChild.firstChild); return d.toString(); });
t("nodeValue elem", function():* { var e:XMLNode = new XMLNode(1, "e"); return [e.nodeValue, e.localName, e.prefix, e.namespaceURI].join(","); });
t("namespace", function():* { var d:XMLDocument = new XMLDocument("<p:a xmlns:p='urn:x'><p:b/></p:a>"); var a:XMLNode = d.firstChild; return [a.nodeName, a.localName, a.prefix, a.namespaceURI, a.firstChild.namespaceURI, a.getNamespaceForPrefix("p"), a.getPrefixForNamespace("urn:x")].join(","); });
t("idMap", function():* { var d:XMLDocument = new XMLDocument("<r><a id='x'/><b id='y'/></r>"); var o:Array = []; for (var k:String in d.idMap) o.push(k + ":" + d.idMap[k].nodeName); return o.sort().join(","); });
t("text node toString", function():* { return new XMLNode(3, "a<b&c").toString(); });
t("nodeName set", function():* { var e:XMLNode = new XMLNode(1, "e"); e.nodeName = "f"; return e.toString(); });
t("hasChildNodes", function():* { var d:XMLDocument = new XMLDocument("<r><a/></r>"); return [d.firstChild.hasChildNodes(), d.firstChild.firstChild.hasChildNodes()].join(","); });
t("new XMLNode bad type", function():* { return new XMLNode(7, "q").toString(); });
t("doc parse twice", function():* { var d:XMLDocument = new XMLDocument("<a/>"); d.parseXML("<b/>"); return d.toString(); });
t("empty", function():* { return [new XMLDocument().toString(), new XMLDocument("").childNodes.length].join(","); });
t("null", function():* { return new XMLDocument(null).toString(); });
t("number", function():* { return new XMLDocument(5).toString(); });
