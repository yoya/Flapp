// 文字列
var s = "Hello, World";
trace("-- basics");
trace(s.length + " " + s.charAt(0) + s.charAt(7) + "[" + s.charAt(50) + "]" + s.charAt(-1) + "|" + s.charCodeAt(0) + " " + s.charCodeAt(50));
trace(s.toUpperCase() + " " + s.toLowerCase());
trace(s.indexOf("o") + " " + s.indexOf("o", 5) + " " + s.indexOf("xyz") + " " + s.lastIndexOf("o") + " " + s.lastIndexOf("o", 5) + " " + s.indexOf(""));
trace("-- substring family");
trace(s.substring(0, 5) + "|" + s.substring(7) + "|" + s.substring(5, 0) + "|" + s.substring(-3, 2) + "|" + s.substring(3, 3) + "|" + s.substring(20) + "|");
trace(s.substr(0, 5) + "|" + s.substr(7) + "|" + s.substr(-5) + "|" + s.substr(-5, 2) + "|" + s.substr(3, 0) + "|" + s.substr(3, -1) + "|");
trace(s.slice(0, 5) + "|" + s.slice(7) + "|" + s.slice(-5) + "|" + s.slice(-5, -2) + "|" + s.slice(5, 2) + "|" + s.slice(2, -20) + "|");
trace("-- split / concat");
trace("a,b,c".split(","));
trace("a,b,c".split(",").length + " " + "abc".split("").length + " " + "abc".split().length + " " + "a,b,c".split(",", 2));
trace("a1b1c".split("1").join("+") + " " + "".split(",").length + " " + ",".split(",").length);
trace("ab".concat("cd", 1, true, null));
trace("-- conversion");
trace("5" + 5 + " " + ("5" * 5) + " " + ("abc" + null) + " " + ("abc" + undefined) + " " + String(123.456) + " " + (123).toString());
trace(String.fromCharCode(72, 105, 33) + " " + String.fromCharCode(12354) + " " + "あ".charCodeAt(0) + " " + "あいう".length);
trace((255).toString(16) + " " + (255).toString(2) + " " + (-255).toString(16) + " " + (0.5).toString(2) + " " + (255).toString(36));
trace("-- comparison");
trace(("a" < "b") + " " + ("B" < "a") + " " + ("abc" == "abc") + " " + ("10" > "9") + " " + ("" < "a"));
trace("-- escape");
trace(escape("a b&c=d/e?f+g") + " " + unescape("a%20b%26c"));
trace(escape("日本") + " " + unescape(escape("日本")));
trace("-- wrapper");
var w = new String("wrapped");
trace(w.length + " " + w.charAt(0) + " " + w.toUpperCase() + " " + typeof w + " " + typeof w.valueOf() + " " + (w == "wrapped"));
trace("-- chained");
trace("  trim me ".split(" ").join("") + " " + "a-b-c".split("-").reverse().join("") + " " + "x".charAt(0).toUpperCase());
trace("-- numbers in strings");
trace("12" + 3 + " " + (1 + 2 + "3") + " " + ("1" - -1) + " " + (1 + "") + " " + ("" + 1.0) + " " + (0.1 * 3));
