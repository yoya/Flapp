// 配列
trace("-- create");
var a = [1, 2, 3];
var b = new Array(3);
var c = new Array(1, 2);
var d = new Array("5");
trace(a + " | " + b + " | " + c + " | " + d + " | " + b.length + " " + d.length + " " + new Array().length);
trace(a.length + " " + a[0] + " " + a[5] + " " + a["1"] + " " + typeof a);
trace("-- length");
a[5] = 6;
trace(a + " " + a.length);
a.length = 2;
trace(a + " " + a.length);
a.length = 4;
trace(a + " " + a.length);
trace("-- push / pop / shift / unshift");
var q = [];
trace(q.push(1) + " " + q.push(2, 3) + " " + q);
trace(q.pop() + " " + q.shift() + " " + q + " " + q.unshift(9, 8) + " " + q);
var empty = [];
trace(empty.pop() + " " + empty.shift() + " " + empty.length);
trace("-- join / toString");
var m = [1, "a", null, undefined, true, [2, 3], {}];
trace(m.join("-"));
trace(m.join());
trace(m.toString());
trace([].join("x") + "|" + [1].join("x"));
trace("-- concat / slice / splice / reverse");
var s = [1, 2, 3, 4, 5];
trace(s.concat(6, [7, 8], [[9]]) + " " + s.length);
trace(s.slice(1, 3) + " | " + s.slice(-2) + " | " + s.slice(2) + " | " + s.slice() + " | " + s.slice(3, 1) + "|");
var sp = [1, 2, 3, 4, 5];
trace(sp.splice(1, 2) + " -> " + sp);
trace(sp.splice(1, 0, "a", "b") + "-> " + sp);
trace(sp.splice(-1) + " -> " + sp);
trace(sp.splice(1) + " -> " + sp);
trace([1, 2, 3].reverse());
trace("-- sort");
trace([3, 1, 10, 2].sort());
trace([3, 1, 10, 2].sort(Array.NUMERIC));
trace([3, 1, 10, 2].sort(Array.NUMERIC | Array.DESCENDING));
trace(["b", "A", "c", "B"].sort());
trace(["b", "A", "c", "B"].sort(Array.CASEINSENSITIVE));
trace([3, 1, 2].sort(function(x, y) { return y - x; }));
trace([3, 1, 2].sort(Array.RETURNINDEXEDARRAY));
var people = [{n: "bob", age: 30}, {n: "al", age: 25}, {n: "cy", age: 35}];
people.sortOn("age", Array.NUMERIC);
trace(people[0].n + people[1].n + people[2].n);
people.sortOn("n");
trace(people[0].n + people[1].n + people[2].n);
trace("-- for in / holes");
var h = [];
h[2] = "c";
h[0] = "a";
var out = "";
for (var i in h) out += i + ":" + h[i] + " ";
trace(out + h.length + " " + h);
trace("-- nested / misc");
var grid = [[1, 2], [3, 4]];
trace(grid[1][0] + " " + grid.length + " " + grid[0].length + " " + grid);
var copy = a;
copy[0] = "changed";
trace(a[0]);
trace((a instanceof Array) + " " + (a.constructor == Array) + " " + typeof Array.prototype.push);
