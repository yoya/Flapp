trace("5" + 4);
trace(5 + "4");
trace("5" - 4);
trace(true + 1);
trace(null + 1);
trace(undefined + 1);
trace("a" * 1);
trace("-- to boolean");
trace(Boolean("") + " " + Boolean("0") + " " + Boolean("a") + " " + Boolean(0) + " " + Boolean(NaN) + " " + Boolean({}) + " " + Boolean(null));
trace((!"" ) + " " + (!"false") + " " + (!0) + " " + (!undefined));
trace("-- equality");
trace((1 == "1") + " " + (0 == "") + " " + (null == undefined) + " " + (null == 0) + " " + (undefined == 0) + " " + (NaN == NaN));
trace((true == 1) + " " + (true == "1") + " " + (true == "true") + " " + ("a" == "a") + " " + ({} == {}));
trace((1 === "1") + " " + (1 === 1) + " " + (null === undefined) + " " + (NaN === NaN));
var o = {};
trace((o == o) + " " + (o === o) + " " + ([1] == 1) + " " + ("1,2" == [1,2]));
trace("-- comparison");
trace((1 < 2) + " " + ("a" < "b") + " " + ("10" < "9") + " " + (10 < "9") + " " + ("abc" < "abd"));
trace((1 < NaN) + " " + (NaN < 1) + " " + (undefined < 1) + " " + (null < 1) + " " + ("a" < 1));
trace((2 > 1) + " " + (2 >= 2) + " " + (1 <= 0) + " " + ("b" > "a"));
trace("-- parse");
trace(parseInt("42px") + " " + parseInt("0x1A") + " " + parseInt("010") + " " + parseInt("abc") + " " + parseInt("12", 8) + " " + parseInt("-7.9"));
trace(parseFloat("3.14abc") + " " + parseFloat(".5") + " " + parseFloat("x") + " " + parseFloat("1e2"));
trace(isNaN("abc") + " " + isNaN("12") + " " + isNaN(undefined) + " " + isFinite(1/0) + " " + isFinite("5"));
trace("-- wrappers");
var s = new String("abc");
var n = new Number(5);
var b = new Boolean(false);
trace(typeof s + " " + typeof n + " " + typeof b);
trace(s + n + " " + s.length + " " + (n + 1) + " " + (b ? "yes" : "no"));
trace((s == "abc") + " " + (n == 5) + " " + (s === "abc"));
