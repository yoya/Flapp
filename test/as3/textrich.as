// 範囲ごとの書式、htmlText の読み書き、appendText などで書式がどうなるか。実機の値を測る
var t:Function = function(name:String, f:Function):void { try { trace(name, f()); } catch (e:Error) { trace(name, "ERR", e.errorID); } };
var tf:TextField = new TextField(); addChild(tf); tf.width = 200; tf.height = 100;
var fmt:Function = function(a:int, b:int):String { var f:TextFormat = tf.getTextFormat(a, b); return [f.font, f.size, f.color, f.bold, f.italic, f.underline, f.url, f.target, f.align, f.leftMargin, f.rightMargin, f.indent, f.leading, f.blockIndent, f.bullet, f.letterSpacing, f.kerning, f.display].join("/"); };
t("default", function():* { tf.text = "abcdef"; return fmt(0, 6); });
t("range bold", function():* { var f:TextFormat = new TextFormat(); f.bold = true; tf.setTextFormat(f, 2, 4); return [fmt(0, 2), fmt(2, 4), fmt(4, 6), fmt(0, 6)].join(" | "); });
t("getTextFormat()", function():* { return tf.getTextFormat().bold; });
t("one char", function():* { return [tf.getTextFormat(2, 3).bold, tf.getTextFormat(1, 2).bold, tf.getTextFormat(3, 4).bold, tf.getTextFormat(3, 5).bold].join(","); });
t("color mix", function():* { var f:TextFormat = new TextFormat(); f.color = 0xff0000; tf.setTextFormat(f, 0, 3); var g:TextFormat = tf.getTextFormat(); return [g.color, g.bold, g.size, tf.getTextFormat(0, 3).color, tf.getTextFormat(3, 6).color].join(","); });
t("htmlText mix", function():* { return tf.htmlText; });
t("range errors", function():* { try { tf.getTextFormat(7, 9); } catch (e:Error) { return e.errorID; } return "none"; });
t("range end>len", function():* { return fmt(4, 99); });
t("range begin>end", function():* { try { return fmt(4, 2); } catch (e:Error) { return "ERR " + e.errorID; } });
t("whole setTextFormat", function():* { tf.text = "abc"; var f:TextFormat = new TextFormat(); f.size = 30; f.italic = true; tf.setTextFormat(f); return fmt(0, 3); });
t("append after whole", function():* { tf.appendText("de"); return [fmt(0, 3), fmt(3, 5), tf.text].join(" | "); });
t("append default", function():* { tf.text = "ab"; var d:TextFormat = new TextFormat(); d.bold = true; d.size = 20; tf.defaultTextFormat = d; tf.appendText("cd"); return [fmt(0, 2), fmt(2, 4)].join(" | "); });
t("text resets", function():* { tf.text = "xy"; return fmt(0, 2); });
t("replaceText mid", function():* { var d:TextFormat = new TextFormat(); d.bold = false; d.size = 12; tf.defaultTextFormat = d; tf.text = "abcdef"; var f:TextFormat = new TextFormat(); f.color = 0xff0000; tf.setTextFormat(f, 2, 4); tf.replaceText(3, 3, "ZZ"); return [tf.text, tf.getTextFormat(2, 3).color, tf.getTextFormat(3, 5).color, tf.getTextFormat(5, 6).color, tf.getTextFormat(6, 7).color].join(","); });
t("replaceText over", function():* { tf.text = "abcdef"; var f:TextFormat = new TextFormat(); f.color = 0xff0000; tf.setTextFormat(f, 0, 2); tf.replaceText(0, 4, "Q"); return [tf.text, tf.getTextFormat(0, 1).color].join(","); });
t("replaceSelected", function():* { tf.text = "abcdef"; var f:TextFormat = new TextFormat(); f.bold = true; tf.setTextFormat(f, 2, 4); tf.setSelection(3, 3); tf.replaceSelectedText("X"); return [tf.text, tf.getTextFormat(3, 4).bold].join(","); });
t("html basic", function():* { tf.htmlText = "<b>x</b><i>y</i><u>z</u>w"; return [tf.text, fmt(0, 1), fmt(1, 2), fmt(2, 3), fmt(3, 4)].join(" | "); });
t("html basic out", function():* { return tf.htmlText; });
t("html font", function():* { tf.htmlText = "<font color='#ff0000' size='20' face='Arial'>w</font>v"; return [tf.text, fmt(0, 1), fmt(1, 2)].join(" | "); });
t("html font out", function():* { return tf.htmlText; });
t("html size rel", function():* { tf.htmlText = "<font size='+4'>a</font><font size='-2'>b</font>"; return [fmt(0, 1), fmt(1, 2)].join(" | "); });
t("html link", function():* { tf.htmlText = "<a href='http://a.example/' target='_blank'>l</a>m"; return [tf.text, fmt(0, 1), fmt(1, 2)].join(" | "); });
t("html link out", function():* { return tf.htmlText; });
t("html p", function():* { tf.htmlText = "<p align='center'>a</p><p align='right'>b</p>c"; return [tf.text.split("\r").join("\\r"), tf.text.length, fmt(0, 1), fmt(2, 3), fmt(4, 5)].join(" | "); });
t("html p out", function():* { return tf.htmlText; });
t("html br", function():* { tf.multiline = true; tf.htmlText = "a<br>b<br/>c &amp; &lt;d&gt; &quot;e&quot; &apos;f&apos; &nbsp;g &#65;h"; return tf.text.split("\r").join("\\r").split("\n").join("\\n"); });
t("html li", function():* { tf.htmlText = "<li>a</li><li>b</li>c"; return [tf.text.split("\r").join("\\r"), fmt(0, 1), fmt(2, 3)].join(" | "); });
t("html li out", function():* { return tf.htmlText; });
t("html textformat", function():* { tf.htmlText = "<textformat leftmargin='10' rightmargin='5' indent='3' blockindent='4' leading='2'>x</textformat>y"; return [fmt(0, 1), fmt(1, 2)].join(" | "); });
t("html tf out", function():* { return tf.htmlText; });
t("html ls", function():* { tf.htmlText = "<font letterspacing='2' kerning='1'>a</font>"; return fmt(0, 1); });
t("html nested", function():* { tf.htmlText = "<b>a<i>b</i>c</b>"; return [fmt(0, 1), fmt(1, 2), fmt(2, 3)].join(" | "); });
t("html nested out", function():* { return tf.htmlText; });
t("html unknown", function():* { tf.htmlText = "<x>a</x><span>b</span><div>c</div>"; return tf.text.split("\r").join("\\r"); });
t("html empty", function():* { tf.htmlText = ""; return [tf.text.length, tf.htmlText].join(","); });
t("text then htmlText", function():* { tf.text = "a<b>&c"; return tf.htmlText; });
t("html not parse text", function():* { tf.text = "<b>x</b>"; return tf.text; });
t("condense", function():* { tf.condenseWhite = true; tf.htmlText = "a   b\n c"; return tf.text.split("\r").join("\\r").split("\n").join("\\n"); });
t("tabstops", function():* { var f:TextFormat = new TextFormat(); f.tabStops = [10, 20]; tf.text = "ab"; tf.setTextFormat(f); return tf.getTextFormat().tabStops; });
t("bullet", function():* { tf.text = "ab"; var f:TextFormat = new TextFormat(); f.bullet = true; tf.setTextFormat(f); return fmt(0, 2); });
t("align para", function():* { tf.text = "aa\rbb\rcc"; var f:TextFormat = new TextFormat(); f.align = "center"; tf.setTextFormat(f, 4, 5); return [fmt(0, 1), fmt(3, 5), fmt(6, 7)].join(" | "); });
t("format fonts", function():* { var d:TextFormat = new TextFormat("Courier New", 14, 0x123456); tf.defaultTextFormat = d; tf.text = "k"; return fmt(0, 1); });
trace("done");
