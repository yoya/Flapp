// オブジェクトとプロトタイプ
trace("-- constructors");
function Animal(name) { this.name = name; this.legs = 4; }
Animal.prototype.speak = function() { return this.name + " speaks"; };
Animal.prototype.kind = "animal";
var a = new Animal("cat");
trace(a.speak() + " " + a.kind + " " + a.legs + " " + (a.constructor == Animal) + " " + (a.__proto__ == Animal.prototype));
trace(a.hasOwnProperty("name") + " " + a.hasOwnProperty("kind") + " " + a.hasOwnProperty("speak"));
trace("-- inheritance");
function Dog(name) { super(name); this.tricks = 0; }
Dog.prototype = new Animal();
Dog.prototype.speak = function() { return super.speak() + " (woof)"; };
Dog.prototype.learn = function() { return ++this.tricks; };
var d = new Dog("rex");
trace(d.speak() + " " + d.kind + " " + d.learn() + d.learn() + " " + d.name);
trace((d instanceof Dog) + " " + (d instanceof Animal) + " " + (d instanceof Object) + " " + (a instanceof Dog));
trace((d.constructor == Animal) + " " + (d.constructor == Dog) + " " + Animal.prototype.isPrototypeOf(d));
trace("-- enumeration with inheritance");
var out = "";
for (var k in d) out += k + " ";
trace(out);
out = "";
for (var k2 in a) out += k2 + " ";
trace(out);
trace("-- property flags");
var o = {a: 1, b: 2, c: 3};
ASSetPropFlags(o, "b", 1);
out = "";
for (var k3 in o) out += k3;
trace(out + " " + o.b);
ASSetPropFlags(o, ["a"], 4);
o.a = 100;
trace(o.a);
ASSetPropFlags(o, "c", 2);
trace(delete o.c);
trace(o.c);
ASSetPropFlags(o, null, 0, 7);
o.a = 200;
out = "";
for (var k4 in o) out += k4;
trace(out + " " + o.a + " " + delete o.c);
trace("-- addProperty");
var acc = {store: 5};
acc.addProperty("double", function() { return this.store * 2; }, function(v) { this.store = v / 2; });
trace(acc.double);
acc.double = 100;
trace(acc.store + " " + acc.double);
acc.addProperty("ro", function() { return "fixed"; }, null);
acc.ro = "changed";
trace(acc.ro);
trace("-- toString / valueOf");
var custom = {toString: function() { return "custom!"; }, valueOf: function() { return 42; }};
trace(custom);
trace(custom + 1);
trace("" + custom);
trace(custom * 2);
trace(String(custom) + " " + Number(custom) + " " + (custom == 42) + " " + (custom > 41));
var plain = {};
trace(plain + " " + plain.toString() + " " + (plain.valueOf() == plain));
trace("-- object literal / dynamic access");
var lit = {x: 1};
lit["y z"] = 2;
lit[3] = "three";
trace(lit.x + " " + lit["y z"] + " " + lit[3] + " " + lit["3"] + " " + lit.missing);
var key = "dyn";
lit[key + 1] = "d1";
trace(lit.dyn1);
lit.nested = {deep: {value: "found"}};
trace(lit.nested.deep.value + " " + lit.nested.nope.value);
trace("-- __proto__ and Object");
var base = {inherited: "yes"};
var child = {};
child.__proto__ = base;
trace(child.inherited + " " + child.hasOwnProperty("inherited") + " " + (child.__proto__ == base));
var made = new Object();
made.p = 1;
trace(made.p + " " + typeof made + " " + (made.constructor == Object) + " " + (made instanceof Object));
trace(typeof Object.prototype + " " + (Object.prototype.__proto__ == undefined) + " " + (Function.prototype.__proto__ == Object.prototype));
