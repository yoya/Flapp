// 標準のクラスと定数が揃っているか（実機の値と比べる）。名前が無ければ、その行は ERR と errorID になる
var t:Function = function(name:String, f:Function):void { try { trace(name, f()); } catch (e:Error) { trace(name, "ERR", e.errorID); } };
t("StageScaleMode", function():* { return [StageScaleMode.NO_SCALE, StageScaleMode.SHOW_ALL, StageScaleMode.EXACT_FIT, StageScaleMode.NO_BORDER].join(","); });
t("StageAlign", function():* { return [StageAlign.TOP, StageAlign.BOTTOM, StageAlign.LEFT, StageAlign.RIGHT, StageAlign.TOP_LEFT, StageAlign.TOP_RIGHT, StageAlign.BOTTOM_LEFT, StageAlign.BOTTOM_RIGHT].join(","); });
t("StageQuality", function():* { return [StageQuality.LOW, StageQuality.MEDIUM, StageQuality.HIGH, StageQuality.BEST].join(","); });
t("StageDisplayState", function():* { return [StageDisplayState.NORMAL, StageDisplayState.FULL_SCREEN, StageDisplayState.FULL_SCREEN_INTERACTIVE].join(","); });
t("BlendMode", function():* { return [BlendMode.ADD, BlendMode.ALPHA, BlendMode.DARKEN, BlendMode.DIFFERENCE, BlendMode.ERASE, BlendMode.HARDLIGHT, BlendMode.INVERT, BlendMode.LAYER, BlendMode.LIGHTEN, BlendMode.MULTIPLY, BlendMode.NORMAL, BlendMode.OVERLAY, BlendMode.SCREEN, BlendMode.SUBTRACT].join(","); });
t("EventPhase", function():* { return [EventPhase.CAPTURING_PHASE, EventPhase.AT_TARGET, EventPhase.BUBBLING_PHASE].join(","); });
t("FocusEvent consts", function():* { return [FocusEvent.FOCUS_IN, FocusEvent.FOCUS_OUT, FocusEvent.KEY_FOCUS_CHANGE, FocusEvent.MOUSE_FOCUS_CHANGE].join(","); });
t("FocusEvent new", function():* { var s:Sprite = new Sprite(); var e:FocusEvent = new FocusEvent("focusIn", true, false, s, true, 9); return [e.type, e.bubbles, e.cancelable, e.relatedObject == s, e.shiftKey, e.keyCode, e.isRelatedObjectInaccessible].join(","); });
t("FocusEvent str", function():* { return new FocusEvent("focusOut").toString(); });
t("FocusEvent clone", function():* { var e:FocusEvent = new FocusEvent("focusOut", false, true, null, true, 3); var c:FocusEvent = e.clone() as FocusEvent; return [c.type, c.cancelable, c.shiftKey, c.keyCode, c != e].join(","); });
t("StatusEvent", function():* { var e:StatusEvent = new StatusEvent("status", false, false, "c", "l"); return [StatusEvent.STATUS, e.code, e.level, e.toString()].join(","); });
t("FullScreenEvent", function():* { var e:FullScreenEvent = new FullScreenEvent("fullScreen", false, false, true); return [FullScreenEvent.FULL_SCREEN, e.fullScreen, e.toString()].join(","); });
t("DataEvent", function():* { var e:DataEvent = new DataEvent("data", false, false, "d"); return [DataEvent.DATA, DataEvent.UPLOAD_COMPLETE_DATA, e.data, e.toString()].join(","); });
t("ContextMenuEvent", function():* { return [ContextMenuEvent.MENU_ITEM_SELECT, ContextMenuEvent.MENU_SELECT].join(","); });
t("Event.formatToString", function():* { return new Event("x", true).toString(); });
t("IEventDispatcher", function():* { var s:Sprite = new Sprite(); var x:IEventDispatcher = s; return [s is IEventDispatcher, new EventDispatcher() is IEventDispatcher, new Timer(10) is IEventDispatcher].join(","); });
t("Keyboard", function():* { return [Keyboard.STOP, Keyboard.PLAY, Keyboard.PAUSE, Keyboard.BACK, Keyboard.INPUT, Keyboard.INFO, Keyboard.MENU, Keyboard.SEARCH, Keyboard.ENTER, Keyboard.F1].join(","); });
t("TextLineMetrics", function():* { var m:TextLineMetrics = new TextLineMetrics(1, 2, 3, 4, 5, 6); return [m.x, m.width, m.height, m.ascent, m.descent, m.leading].join(","); });
t("ContextMenu", function():* { var m:ContextMenu = new ContextMenu(); m.hideBuiltInItems(); var i:ContextMenuItem = new ContextMenuItem("a", true, false, true); return [m.customItems.length, i.caption, i.separatorBefore, i.enabled, i.visible, ContextMenu.isSupported].join(","); });
t("Responder", function():* { var r:Responder = new Responder(function():void {}, null); return r != null; });
t("ObjectEncoding", function():* { return [ObjectEncoding.AMF0, ObjectEncoding.AMF3, ObjectEncoding.DEFAULT].join(","); });
t("StyleSheet", function():* { var s:StyleSheet = new StyleSheet(); s.setStyle(".a", {color: "#ff0000"}); return [s.styleNames.join(","), s.getStyle(".a").color].join(","); });
t("LocalConnection", function():* { var l:LocalConnection = new LocalConnection(); return [l is EventDispatcher, LocalConnection.isSupported].join(","); });
t("AccessibilityProperties", function():* { var a:AccessibilityProperties = new AccessibilityProperties(); a.name = "n"; return [a.name, a.silent, a.forceSimple].join(","); });
t("Accessibility", function():* { return [Accessibility.active].join(","); });
t("Vector3D", function():* { var v:Vector3D = new Vector3D(1, 2, 3); return [v.x, v.length, Vector3D.X_AXIS.x].join(","); });
t("SoundLoaderContext", function():* { var c:SoundLoaderContext = new SoundLoaderContext(1000, true); return [c.bufferTime, c.checkPolicyFile].join(","); });
t("BitmapFilterQuality", function():* { return [BitmapFilterQuality.LOW, BitmapFilterQuality.MEDIUM, BitmapFilterQuality.HIGH].join(","); });
t("BitmapFilterType", function():* { return [BitmapFilterType.INNER, BitmapFilterType.OUTER, BitmapFilterType.FULL].join(","); });
t("SharedObjectFlushStatus", function():* { return [SharedObjectFlushStatus.FLUSHED, SharedObjectFlushStatus.PENDING].join(","); });
t("IExternalizable", function():* { return IExternalizable != null; });
t("IBitmapDrawable", function():* { return [new Sprite() is IBitmapDrawable, new BitmapData(1, 1) is IBitmapDrawable].join(","); });
t("SecurityDomain", function():* { return SecurityDomain.currentDomain != null; });
t("IME", function():* { return IME.isSupported; });
t("PrintJob", function():* { return PrintJob.isSupported; });
t("URLStream", function():* { var u:URLStream = new URLStream(); return u.connected; });
t("Clipboard", function():* { return Clipboard.generalClipboard != null; });
t("FileReference", function():* { var f:FileReference = new FileReference(); return f.name; });
t("GraphicsSolidFill", function():* { var g:GraphicsSolidFill = new GraphicsSolidFill(0xff0000, 0.5); return [g.color, g.alpha].join(","); });
t("UncaughtErrorEvent", function():* { return UncaughtErrorEvent.UNCAUGHT_ERROR; });
trace("done");
