// StyleSheet: ブロックのタグの前後の改行、クラスの当たる相手、あとの書式 API、font-family の写し方。実機の値を測る
var t:Function = function(name:String, f:Function):void { try { trace(name, f()); } catch (e:Error) { trace(name, "ERR", e.errorID); } };
var tf:TextField = new TextField(); addChild(tf); tf.width = 300; tf.height = 100; tf.multiline = true; tf.wordWrap = true;
var ss:StyleSheet = new StyleSheet();
ss.parseCSS("div { color: #00ff00; } em { font-style: italic; } h1 { font-size: 30px; } p { font-size: 20px; color: #ff0000; } .x { font-size: 40px; } a { color: #333333; } li { color: #888888; } .m { font-family: monospace; } .s { font-family: sans-serif; } .r { font-family: serif; } .l { font-family: Arial, Helvetica; } .q { font-family: 'Times New Roman'; } .w { font-weight: bold; font-style: italic; text-decoration: underline; } .n { font-weight: normal; font-style: normal; text-decoration: none; } .j { text-align: justify; } .c { text-align: center; } .neg { margin-left: -5px; } .ff { font-size: 12.5px; } .big { font-size: 1000px; } .z { font-size: 0px; } .nn { color: #xyz; } .e { color: ; } .noimp { color: #ff0000 !important; }");
var fmt:Function = function(a:int, b:int):String { var f:TextFormat = tf.getTextFormat(a, b); return [f.font, f.size, f.color, f.bold, f.italic, f.underline, f.url, f.align, f.leftMargin, f.rightMargin, f.indent, f.leading, f.bullet, f.letterSpacing, f.kerning].join("/"); };
var show:Function = function(s:String):String { return s.split("\r").join("\\r").split("\n").join("\\n"); };
tf.styleSheet = ss;
t("div mid", function():* { tf.htmlText = "x<div>a</div>z"; return [show(tf.text), fmt(0, 1), fmt(1, 2), fmt(3, 4)].join(" | "); });
t("div twice", function():* { tf.htmlText = "<div>a</div><div>b</div>"; return [show(tf.text), fmt(0, 1), fmt(2, 3)].join(" | "); });
t("div empty", function():* { tf.htmlText = "x<div></div>z"; return show(tf.text); });
t("div in p", function():* { tf.htmlText = "<p>a<div>b</div>c</p>d"; return [show(tf.text), fmt(0, 1), fmt(2, 3), fmt(4, 5)].join(" | "); });
t("em in div", function():* { tf.htmlText = "<div>a<em>b</em>c</div>"; return [show(tf.text), fmt(0, 1), fmt(2, 3), fmt(4, 5)].join(" | "); });
t("h1", function():* { tf.htmlText = "<h1>a</h1>z"; return [show(tf.text), fmt(0, 1), fmt(2, 3)].join(" | "); });
t("h2 unstyled", function():* { tf.htmlText = "<h2>a</h2>z"; return show(tf.text); });
t("class on a", function():* { tf.htmlText = "<a class='x' href='u'>a</a>z"; return [show(tf.text), fmt(0, 1)].join(" | "); });
t("class on div", function():* { tf.htmlText = "<div class='x'>a</div>z"; return [show(tf.text), fmt(0, 1)].join(" | "); });
t("class on li", function():* { tf.htmlText = "<li class='x'>a</li>z"; return [show(tf.text), fmt(0, 1)].join(" | "); });
t("class on font", function():* { tf.htmlText = "<font class='x'>a</font>z"; return fmt(0, 1); });
t("class on i", function():* { tf.htmlText = "<i class='x'>a</i>z"; return fmt(0, 1); });
t("class on u", function():* { tf.htmlText = "<u class='x'>a</u>z"; return fmt(0, 1); });
t("class on textformat", function():* { tf.htmlText = "<textformat class='x'>a</textformat>z"; return fmt(0, 1); });
t("class on em", function():* { tf.htmlText = "<em class='x'>a</em>z"; return [show(tf.text), fmt(0, 1)].join(" | "); });
t("class on unstyled tag", function():* { tf.htmlText = "<q class='x'>a</q>z"; return [show(tf.text), fmt(0, 1)].join(" | "); });
t("class on br", function():* { tf.htmlText = "a<br class='x'>z"; return [show(tf.text), fmt(1, 2)].join(" | "); });
t("p tag+class", function():* { tf.htmlText = "<p class='x'>a</p>"; return fmt(0, 1); });
t("font-family monospace", function():* { tf.htmlText = "<span class='m'>a</span>"; return fmt(0, 1); });
t("font-family sans-serif", function():* { tf.htmlText = "<span class='s'>a</span>"; return fmt(0, 1); });
t("font-family serif", function():* { tf.htmlText = "<span class='r'>a</span>"; return fmt(0, 1); });
t("font-family list", function():* { tf.htmlText = "<span class='l'>a</span>"; return fmt(0, 1); });
t("font-family quoted", function():* { tf.htmlText = "<span class='q'>a</span>"; return fmt(0, 1); });
t("bold italic underline", function():* { tf.htmlText = "<span class='w'>a</span>"; return fmt(0, 1); });
t("normal after b", function():* { tf.htmlText = "<b><i><u><span class='n'>a</span></u></i></b>"; return fmt(0, 1); });
t("normal in p", function():* { tf.htmlText = "<b><span class='n'>a</span></b>"; return fmt(0, 1); });
t("justify", function():* { tf.htmlText = "<p class='j'>a</p>"; return fmt(0, 1); });
t("center on span", function():* { tf.htmlText = "<span class='c'>a</span>"; return fmt(0, 1); });
t("neg margin", function():* { tf.htmlText = "<span class='neg'>a</span>"; return fmt(0, 1); });
t("frac size", function():* { tf.htmlText = "<span class='ff'>a</span>"; return fmt(0, 1); });
t("big size", function():* { tf.htmlText = "<span class='big'>a</span>"; return fmt(0, 1); });
t("zero size", function():* { tf.htmlText = "<span class='z'>a</span>"; return fmt(0, 1); });
t("bad color", function():* { tf.htmlText = "<span class='nn'>a</span>"; return fmt(0, 1); });
t("empty color", function():* { tf.htmlText = "<span class='e'>a</span>"; return fmt(0, 1); });
t("important", function():* { tf.htmlText = "<span class='noimp'>a</span>"; return fmt(0, 1); });
t("font tag in css span", function():* { tf.htmlText = "<span class='x'><font size='9'>a</font></span>"; return fmt(0, 1); });
t("css span in font", function():* { tf.htmlText = "<font size='9' color='#00ff00'><span class='x'>a</span></font>"; return fmt(0, 1); });
t("replaceSelectedText", function():* { tf.htmlText = "<p>ab</p>"; tf.replaceSelectedText("Z"); return "ok"; });
t("defaultTextFormat set", function():* { tf.defaultTextFormat = new TextFormat(); return "ok"; });
t("defaultTextFormat get", function():* { return tf.defaultTextFormat.size; });
t("setTextFormat whole", function():* { tf.setTextFormat(new TextFormat()); return "ok"; });
t("getTextFormat ok", function():* { return fmt(0, 1); });
t("text getter", function():* { tf.text = "<b>hi</b>"; return [tf.text, tf.htmlText, tf.length].join(" | "); });
t("input", function():* { tf.type = "input"; tf.htmlText = "<p>q</p>"; return fmt(0, 1); });
t("autoSize", function():* { tf.type = "dynamic"; tf.autoSize = "left"; tf.htmlText = "<p>abc</p><p>def</p>"; return [tf.textWidth > 0, tf.textHeight > 0, tf.numLines].join(","); });
t("numLines", function():* { tf.autoSize = "none"; tf.htmlText = "a<div>b</div>c"; return [tf.numLines, show(tf.text)].join(","); });
