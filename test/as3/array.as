// Array と Object
var a:Array = [3, 1, 2];
trace(a, a.length, a.join("-"), a.toString(), a[0], a[5], a.indexOf(2), a.indexOf(9), a.lastIndexOf(3));
trace(a.push(4, 5), a, a.pop(), a.shift(), a, a.unshift(9, 8), a);
trace(a.concat([7], 6, [[5]]).length, a.slice(1, 3), a.slice(-2), a.reverse(), a);
trace(a.splice(1, 2), a, a.splice(1, 0, "x", "y"), a, a.splice(-1), a);
a = [10, 9, 1, 100, "b", "a", null, undefined];
trace(a.sort(), a.length);
a = [10, 9, 1, 100]; trace(a.sort(), a.sort(Array.NUMERIC), a.sort(Array.NUMERIC | Array.DESCENDING), a.sort(function(x:int, y:int):int { return x % 10 - y % 10; }));
a = ["b", "A", "c", "B"]; trace(a.sort(), a.sort(Array.CASEINSENSITIVE), a.sort(Array.RETURNINDEXEDARRAY), a.sort(Array.DESCENDING));
var people:Array = [{n: "x", age: 30}, {n: "y", age: 4}, {n: "z", age: 30}];
people.sortOn("age", Array.NUMERIC); trace(people[0].n, people[1].n, people[2].n);
people.sortOn(["age", "n"], [Array.NUMERIC | Array.DESCENDING, Array.DESCENDING]); trace(people[0].n, people[1].n, people[2].n);
a = [1, 2, 3, 4];
trace(a.map(function(v:int, i:int, arr:Array):int { return v * i; }), a.filter(function(v:int, i:int, arr:Array):Boolean { return v % 2 == 0; }), a.some(function(v:int, i:int, arr:Array):Boolean { return v > 3; }), a.every(function(v:int, i:int, arr:Array):Boolean { return v > 3; }));
var total:int = 0; a.forEach(function(v:int, i:int, arr:Array):void { total += v; }); trace(total);
a.length = 2; trace(a, a.length); a[5] = 6; trace(a, a.length, a[3], 3 in a, 5 in a, "5" in a);
a = new Array(3); trace(a.length, a[0], a); a = new Array("3"); trace(a.length, a); a = new Array(1, 2); trace(a);
var nested:Array = [1, [2, [3, [4]]]]; trace(nested, nested[1][1][1][0], nested.length);
trace([] + [], [1] + [2], [1, 2] == "1,2", [null, undefined, NaN, true]);
trace("-- Object");
var o:Object = {x: 1, "y z": 2, 3: "three"};
trace(o.x, o["y z"], o[3], o["3"], o.missing, o.toString(), "x" in o, o.hasOwnProperty("x"), o.hasOwnProperty("toString"), "toString" in o);
o.x++; o["new"] = o.x * 2; delete o[3]; trace(o.x, o["new"], o[3]);
var keys:Array = []; for (var k:String in o) keys.push(k); keys.sort(); trace(keys);
var copy:Object = o; copy.x = 99; trace(o.x, o == copy, o === copy, {} == {});
trace(o.valueOf() == o, o.propertyIsEnumerable("x"), o.isPrototypeOf(o), Object.prototype.isPrototypeOf(o));
o.toString = function():String { return "custom"; }; trace("" + o, String(o), o);
o.valueOf = function():Number { return 42; }; trace(o + 1, o * 2, o > 41, "" + o);
trace("-- for each order");
var list:Array = ["a", "b", "c"]; var out:String = ""; for each (var item:String in list) out += item; trace(out);
list[10] = "k"; out = ""; for (var idx:String in list) out += idx + ","; trace(out);
