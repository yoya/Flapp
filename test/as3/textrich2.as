// textrich の続き: multiline の段落、align、textformat、br、改行の書き出し
var t:Function = function(name:String, f:Function):void { try { trace(name, f()); } catch (e:Error) { trace(name, "ERR", e.errorID); } };
var tf:TextField = new TextField(); addChild(tf); tf.width = 200; tf.height = 100; tf.multiline = true;
var esc:Function = function(s:String):String { return s.split("\r").join("\\r").split("\n").join("\\n"); };
var fmt:Function = function(a:int, b:int):String { var f:TextFormat = tf.getTextFormat(a, b); return [f.size, f.bold, f.italic, f.align, f.leftMargin, f.rightMargin, f.indent, f.leading, f.blockIndent, f.bullet].join("/"); };
t("p align", function():* { tf.htmlText = "<p align='center'>a</p><p align='right'>b</p>c"; return [esc(tf.text), fmt(0, 1), fmt(2, 3), fmt(4, 5)].join(" | "); });
t("p out", function():* { return tf.htmlText; });
t("p twice", function():* { tf.htmlText = "<p>a</p><p>b</p>"; return esc(tf.text); });
t("p out2", function():* { return tf.htmlText; });
t("br", function():* { tf.htmlText = "a<br>b<br/>c"; return esc(tf.text); });
t("br out", function():* { return tf.htmlText; });
t("text cr", function():* { tf.text = "a\rb\nc\r\nd"; return esc(tf.text); });
t("text cr out", function():* { return tf.htmlText; });
t("para fmt", function():* { tf.text = "aa\rbb\rcc"; var f:TextFormat = new TextFormat(); f.align = "center"; f.leftMargin = 10; tf.setTextFormat(f, 4, 5); return [fmt(0, 1), fmt(3, 5), fmt(6, 7), fmt(3, 4)].join(" | "); });
t("para out", function():* { return tf.htmlText; });
t("textformat p", function():* { tf.htmlText = "<textformat leftmargin='10' indent='3'>x<br>y</textformat>z"; return [esc(tf.text), fmt(0, 1), fmt(2, 3), fmt(4, 5)].join(" | "); });
t("textformat out", function():* { return tf.htmlText; });
t("li", function():* { tf.htmlText = "<li>a</li><li>b</li>c"; return [esc(tf.text), fmt(0, 1), fmt(2, 3), fmt(4, 5)].join(" | "); });
t("li out", function():* { return tf.htmlText; });
t("empty p", function():* { tf.htmlText = "<p>a</p><p></p><p>b</p>"; return esc(tf.text); });
t("trailing br", function():* { tf.htmlText = "a<br>"; return esc(tf.text) + " " + tf.text.length; });
t("leading br", function():* { tf.htmlText = "<br>a"; return esc(tf.text); });
t("font in p", function():* { tf.htmlText = "<p align='right'><font color='#00ff00'>g</font>h</p>"; return [esc(tf.text), fmt(0, 1)].join(" | "); });
t("font in p out", function():* { return tf.htmlText; });
t("size abs", function():* { tf.htmlText = "<font size='7'>a</font><font size='100'>b</font><font size='0'>c</font>"; return [tf.getTextFormat(0, 1).size, tf.getTextFormat(1, 2).size, tf.getTextFormat(2, 3).size].join(","); });
t("color forms", function():* { tf.htmlText = "<font color='#f00'>a</font><font color='red'>b</font><font color='#00FF00'>c</font><font color='0000ff'>d</font>"; return [0, 1, 2, 3].map(function(i:int, ...r):* { return tf.getTextFormat(i, i + 1).color; }).join(","); });
t("a no href", function():* { tf.htmlText = "<a>a</a><a href='x'>b</a><a href='y' target='t'>c</a>"; return [tf.getTextFormat(0, 1).url, tf.getTextFormat(1, 2).url, tf.getTextFormat(2, 3).url, tf.getTextFormat(2, 3).target].join(","); });
t("a out", function():* { return tf.htmlText; });
t("entity out", function():* { tf.text = "<>&\"' é 日本"; return tf.htmlText; });
t("condense html", function():* { tf.condenseWhite = true; tf.htmlText = "a   b <b> c </b>\n d"; return esc(tf.text); });
t("not condense", function():* { tf.condenseWhite = false; tf.htmlText = "a   b\n c"; return esc(tf.text); });
t("html comment", function():* { tf.htmlText = "a<!-- x -->b<?pi?>c"; return esc(tf.text); });
t("html bad", function():* { tf.htmlText = "a<b>b<i>c</b>d</i>e<"; return esc(tf.text); });
t("html bad2", function():* { tf.htmlText = "<b a='1'>x</b >y< b>z"; return esc(tf.text) + "|" + [tf.getTextFormat(0, 1).bold, tf.getTextFormat(1, 2).bold].join(","); });
t("upper tags", function():* { tf.htmlText = "<B>a</B><I>b</I><FONT COLOR='#ff0000'>c</FONT><BR>d"; return [esc(tf.text), tf.getTextFormat(0, 1).bold, tf.getTextFormat(2, 3).color].join(","); });
t("sup/sub", function():* { tf.htmlText = "a<sup>b</sup><sub>c</sub>"; return esc(tf.text); });
t("span class", function():* { tf.htmlText = "<span class='x'>a</span>"; return esc(tf.text); });
t("tab", function():* { tf.htmlText = "a\tb"; return esc(tf.text).split("\t").join("\\t"); });
t("getTextFormat last", function():* { tf.text = "abc"; return [tf.getTextFormat(3, 3) != null, tf.getTextFormat(0, 3).size].join(","); });
t("empty text fmt", function():* { tf.text = ""; var d:TextFormat = new TextFormat(); d.size = 22; tf.defaultTextFormat = d; return [tf.getTextFormat().size, tf.getTextFormat(0, 0).size].join(","); });
trace("done");
